# Minerva environment variables.
#
# Copy to `.env` at the repo root and start the stack with:
#   docker compose --env-file .env -f deploy/docker-compose.yml up --build
# (Compose looks for `.env` next to the compose file, in `deploy/`, not at
# the repo root — hence the explicit `--env-file`.)
#
# Every value may stay empty: empty means "default" or "feature off". The
# compose file falls back to dev defaults for everything, so an untouched
# copy starts the stack with OIDC disabled.

## Server — core

# Postgres connection string. Required to run the server at all; no default.
# Compose dev default: postgresql://minerva:minerva@postgres:5432/minerva
DATABASE_URL=

# Port the API listens on inside its container (default 8080). The compose
# file maps host port 3010 to it — change both together if you change this.
PORT=

# Session storage backend: a reachable Redis URL, or empty for Postgres-backed
# sessions. Compose dev default: redis://redis:6379
REDIS_URL=

# Set to "false" to skip applying database migrations at server startup
# (default: run). Useful when a separate migration job owns the schema.
RUN_MIGRATIONS=

# Set to "true" to mark session and OIDC state cookies Secure. Leave empty
# for local http:// development; set it once the stack is served over https.
COOKIE_SECURE=

## Server — single sign-on (OIDC)

# OIDC is fully disabled while this is empty: the /api/auth/oidc/* routes
# return 404 and none of the other OIDC variables are even read. Set it to
# your provider's issuer URL (the base of its /.well-known/openid-configuration),
# e.g. https://auth.example.com/application/o/minerva/
OIDC_ISSUER_URL=

# --- Required once OIDC_ISSUER_URL is set; startup fails naming the missing one ---

# Client ID of the OIDC application registered at your provider.
OIDC_CLIENT_ID=

# Client secret of that application. Never commit a real one.
OIDC_CLIENT_SECRET=

# Redirect URI registered at the provider — it must match exactly. It is the
# API base URL plus /api/auth/oidc/callback; for the dev compose stack:
#   http://localhost:3010/api/auth/oidc/callback
OIDC_REDIRECT_URL=

# Key for the encrypted OIDC state cookie. Must be at least 32 bytes;
# generate one with: openssl rand -hex 32
OIDC_STATE_SECRET=

# Absolute public URL of the origin serving the API (no trailing slash);
# post-login and error redirects are built from it. Dev compose stack:
#   http://localhost:3010
WEB_BASE_URL=

# --- Optional once OIDC_ISSUER_URL is set (defaults in parentheses) ---

# Name shown for the SSO option (default: "Single sign-on").
OIDC_DISPLAY_NAME=

# Space-separated scopes to request; "openid" is always included
# (default: "openid email profile").
OIDC_SCOPES=

# ID-token claim holding the user's groups (default: "groups").
OIDC_GROUPS_CLAIM=

# Create an account for first-time SSO logins (default: true); set to "false"
# to only allow sign-in with existing accounts.
OIDC_AUTO_CREATE_USERS=
